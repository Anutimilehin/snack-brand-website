# Create a sending-only Resend API key and keep the real value in .env or your host's secrets.
RESEND_API_KEY=re_your_server_side_key

# Must be an address at a domain verified for sending in Resend.
RESEND_FROM_EMAIL="Jidex Foods <website@your-verified-domain.com>"

# Shared production rate limiting (Upstash Redis REST API; server-side only).
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_server_side_token
